  "description": "Limelight's shared agent skills: one marketplace, one plugin per team, validated on every change.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "node tools/validate.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
